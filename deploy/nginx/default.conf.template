worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;

    resolver ${DNS_RESOLVER} valid=30s ipv6=off;
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        "" $scheme;
    }

    limit_req_zone $client_ip zone=site:10m rate=10r/s;
    limit_req_zone $client_ip zone=sessions:10m rate=5r/m;
    limit_req_zone $client_ip zone=conversions:10m rate=10r/m;
    limit_req_zone $client_ip zone=quotes:10m rate=30r/m;

    map $http_cf_connecting_ip $client_ip {
        "" $remote_addr;
        default $http_cf_connecting_ip;
    }

    server {
        listen ${PORT};
        set $app_upstream "${APP_UPSTREAM}";
        server_name _;
        server_tokens off;

        client_max_body_size 16k;
        client_header_timeout 10s;
        client_body_timeout 10s;
        keepalive_timeout 15s;
        send_timeout 10s;
        limit_req_status 429;
        client_body_temp_path /tmp/client_body;
        proxy_temp_path /tmp/proxy_temp;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        location = /api/security/csrf {
            limit_req zone=sessions burst=10 nodelay;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }

        location = /converter {
            limit_req zone=conversions burst=8 nodelay;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }

        location = /historico/limpar {
            limit_req zone=conversions burst=5 nodelay;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }

        location ^~ /api/conversoes {
            limit_req zone=conversions burst=8 nodelay;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }

        location ^~ /api/cotacoes {
            limit_req zone=quotes burst=15 nodelay;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }

        location / {
            limit_req zone=site burst=30 nodelay;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $client_ip;
            proxy_set_header X-Forwarded-For $client_ip;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_connect_timeout 3s;
            proxy_read_timeout 10s;
            proxy_send_timeout 10s;
        }
    }
}
