{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "src/main/resources/static/js/**/*.js",
      "src/main/resources/static/css/**/*.css",
      "cloudflare-pages/content/**/*.js",
      "scripts/**/*.mjs",
      "tests/**/*.cjs",
      "!!.stryker-tmp",
      "!!stryker-tmp"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "auto",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
